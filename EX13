import pandas as pd
from sklearn.linear_model import LinearRegression


data = {
    "Year": [2018, 2019, 2020, 2021, 2022],
    "Kilometers": [50000, 40000, 30000, 20000, 10000],
    "Engine": [1.2, 1.5, 1.5, 1.6, 2.0],
    "Price": [500000, 650000, 800000, 950000, 1200000]
}

df = pd.DataFrame(data)

X = df[["Year", "Kilometers", "Engine"]]
y = df["Price"]


model = LinearRegression()
model.fit(X, y)


year = int(input("Enter car year: "))
km = float(input("Enter kilometers: "))
engine = float(input("Enter engine size: "))

price = model.predict([[year, km, engine]])


print("Predicted Car Price:", round(price[0], 2))
