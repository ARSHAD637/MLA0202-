from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures

# Data
X = [[1],[2],[3],[4],[5]]
y = [1,4,9,16,25]

# Linear Regression
lr = LinearRegression()
lr.fit(X, y)
print("Linear Prediction:", lr.predict([[6]]))

# Polynomial Regression
poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

pr = LinearRegression()
pr.fit(X_poly, y)
print("Polynomial Prediction:", pr.predict(poly.transform([[6]])))
