from sklearn.neighbors import KNeighborsClassifier


X = [
    [5.1, 3.5],
    [4.9, 3.0],
    [6.2, 3.4],
    [5.9, 3.0]
]


y = [0, 0, 1, 1]

model = KNeighborsClassifier(n_neighbors=3)


model.fit(X, y)


result = model.predict([[5.0, 3.4]])

if result[0] == 0:
    print("Iris Flower: Setosa")
else:
    print("Iris Flower: Versicolor")
